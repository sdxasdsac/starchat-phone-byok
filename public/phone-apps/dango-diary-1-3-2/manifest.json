{
  "sdkVersion": "1.0",
  "id": "dango.diary",
  "name": "团子共养日记",
  "version": "1.3.2",
  "author": "Codex × Fish",
  "description": "24种柔和小动物与物种专属自然毛色、6套清新主题。为每个角色匹配宠物性格，一起照顾、聊天、读爪爪日记与角色悄悄话，还能调用生图API绘制专属画像。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "ai.generate",
    "ai.chat",
    "ai.generateImage",
    "chat.sendCard"
  ],
  "resources": {
    "presets": [
      "presets.json"
    ]
  },
  "extensions": {
    "chat": {
      "plusActions": [
        {
          "id": "dango-home",
          "label": "团子小窝",
          "entry": "home",
          "presentation": "fullscreen",
          "description": "和当前角色一起照顾团子"
        }
      ]
    }
  }
}
