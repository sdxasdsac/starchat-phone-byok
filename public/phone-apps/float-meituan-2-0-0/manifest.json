{
  "id": "float.meituan",
  "name": "美团",
  "version": "2.0.0",
  "sdkVersion": "1.0",
  "author": "小坊",
  "description": "深度仿美团App的高保真虚拟手机生活服务中心。涵盖外卖美食、特惠团购、酒店民宿、电影演出等板块，支持双向投喂、消费扣减全局钱包，以美食、电影、酒店等多维玩法激发AI主动聊天。",
  "icon": "IMG_5095.jpeg",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "chat.read",
    "chat.read.background",
    "chat.write",
    "chat.sendCard",
    "chat.requestReply",
    "ai.generate",
    "user.profile.read",
    "ui.toast",
    "ui.notification",
    "wallet.read",
    "wallet.pay",
    "tasks.schedule"
  ],
  "resources": {
    "presets": [
      "presets.json"
    ],
    "regexes": [],
    "worldBooks": [],
    "bindings": [],
    "tools": [],
    "voices": [],
    "assets": []
  },
  "primaryTags": [],
  "extensions": {
    "chat": {
      "directives": [
        {
          "id": "ai-order-life",
          "label": "角色送心意",
          "syntax": "[生活心意:收餐人:品类:店铺:商品:备注]",
          "description": "当角色主动给用户下单外卖、团购、电影票并送达时调用。",
          "card": {
            "appLabel": "美团",
            "title": "TA送来的心意服务",
            "subtitle": "{{店铺}} - {{商品}}",
            "body": "类型：{{品类}} | 备注：{{备注}}",
            "status": "已下单",
            "accentColor": "#FFC300",
            "sections": [
              {
                "title": "心意明细",
                "rows": [
                  {
                    "label": "收货人",
                    "value": "{{收餐人}}"
                  },
                  {
                    "label": "品类",
                    "value": "{{品类}}"
                  },
                  {
                    "label": "店名",
                    "value": "{{店铺}}"
                  },
                  {
                    "label": "心意物件",
                    "value": "{{商品}}"
                  },
                  {
                    "label": "寄语",
                    "value": "{{备注}}"
                  }
                ]
              }
            ],
            "actions": [
              {
                "label": "查看配送/票券"
              }
            ]
          },
          "tags": []
        }
      ],
      "plusActions": [
        {
          "id": "order-for-ai",
          "label": "美团投喂",
          "description": "打开美团，请AI吃外卖、看电影、住别墅，激发主动聊天。",
          "entry": "order-for-ai",
          "presentation": "panel",
          "panelHeight": "85vh",
          "tags": []
        }
      ]
    },
    "events": [
      {
        "event": "chat.message.created",
        "entry": "events",
        "background": true,
        "description": "在后台监听聊天关键词，激发AI发起反向宠溺外卖/电影票预订动作。"
      }
    ]
  },
