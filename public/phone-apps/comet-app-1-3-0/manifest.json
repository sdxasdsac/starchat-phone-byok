{
  "sdkVersion": "1.0",
  "id": "comet.app",
  "name": "Comet",
  "version": "1.3.0",
  "author": "小玉",
  "description": "以TA的助理身份运营TA的社交媒体账号",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "app.assets.read",
    "characters.read",
    "user.profile.read",
    "ai.generate",
    "ai.chat",
    "ai.generateImage",
    "chat.sendCard",
    "memory.write",
    "media.pick",
    "media.put",
    "media.get",
    "wallet.read",
    "wallet.pay",
    "ui.toast",
    "network.fetch"
  ],
  "network": {
    "allowedDomains": [
      "api.openai.com",
      "api.anthropic.com",
      "generativelanguage.googleapis.com",
      "api.deepseek.com",
      "*.deepseek.com",
      "dashscope.aliyuncs.com",
      "*.aliyuncs.com",
      "api.moonshot.cn",
      "*.moonshot.cn",
      "openrouter.ai",
      "*.openrouter.ai",
      "api.siliconflow.cn",
      "*.siliconflow.cn"
    ]
  },
  "resources": {
    "presets": ["presets.json"],
    "assets": ["icon.png"]
  },
  "extensions": {
    "chat": {
      "directives": [],
      "plusActions": []
    },
    "events": []
  }
}
