# 这个项目默认不需要任何服务端环境变量：
# 文字 / 语音 / 图像 / 语音识别 都由用户在「设置」里填写自己的 API Key，
# Key 只保存在用户浏览器本地，请求经用户自己部署的 Vercel 函数透传，服务端不落盘。

# 可选：站点名称（显示在 PWA 桌面图标下）
NEXT_PUBLIC_APP_NAME=小手机

# 可选：proxy（默认，推荐，绕过 CORS）| direct（浏览器直连第三方 API）
NEXT_PUBLIC_API_MODE=proxy

# 可选：部署在子路径时填写，例如 /phone（Vercel 根目录部署留空）
# NEXT_PUBLIC_BASE_PATH=/phone
